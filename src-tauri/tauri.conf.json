{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kanvault",
  "mainBinaryName": "kanvault",
  "version": "1.0.0",
  "identifier": "com.dagcan.istakip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kanvault",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "contentProtected": true
      },
      {
        "label": "quick",
        "title": "Kanvault — Quick Task",
        "width": 560,
        "height": 236,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "center": true,
        "theme": "Dark",
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Kanvault — Task & Security Hub",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "tr-TR"
      },
      "nsis": {
        "languages": [
          "English",
          "Turkish"
        ],
        "displayLanguageSelector": true
      }
    },
    "longDescription": "Free, open-source task board with a zero-knowledge vault and AI reporting for IT teams. Developed by Dağcan Nural. / BT ekipleri için ücretsiz, açık kaynak iş panosu, sıfır bilgi kasası ve AI raporlama. Dağcan Nural tarafından geliştirilmiştir.",
    "copyright": "© 2026 Dağcan Nural — MIT License",
    "publisher": "Dağcan Nural"
  }
}
